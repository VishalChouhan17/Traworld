
<% layout("/layouts/boilerplate") -%>

<style>
  :root {
    --bg-glow: rgba(255, 56, 92, 0.35);
  }

  .filter-wrapper {
    position: sticky;
    top: 1rem;
    z-index: 100;
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    background: rgba(255, 255, 255, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 999px;
    padding: 0.75rem 1.5rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.06);
    margin-bottom: 2.5rem;
  }

  #filters {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }

  #filters::-webkit-scrollbar {
    display: none;
  }

  .filter {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    opacity: 0.6;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    cursor: pointer;
    white-space: nowrap;
  }

  .filter i {
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
    transition: transform 0.3s ease;
  }

  .filter p {
    font-size: 0.75rem;
    font-weight: 600;
    margin: 0;
  }

  .filter:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .filter:hover i {
    transform: scale(1.2);
  }

  .filter-link {
    text-decoration: none;
    color: inherit;
    opacity: 0.7;
    transition: opacity 0.2s ease, border-bottom 0.2s ease;
  }

  .filter-link:hover,
  .filter-link.active-filter {
    opacity: 1;
    border-bottom: 2px solid #000;
  }

  .clear-btn {
    text-decoration: none;
    color: #fe424d;
    font-weight: 600;
    margin-left: auto;
    align-self: center;
  }

  /* 3D Dynamic Card Layout */
  .grid-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
    perspective: 1000px;
  }

  .listing-card-wrapper {
    position: relative;
    text-decoration: none !important;
    color: inherit;
    border-radius: 24px;
    perspective: 1000px;
  }

  /* Dynamic Ambient Glow Behind Card */
  .ambient-glow {
    position: absolute;
    inset: -10px;
    background: radial-gradient(circle, var(--bg-glow) 0%, rgba(255,255,255,0) 70%);
    border-radius: 32px;
    opacity: 0;
    filter: blur(20px);
    transition: opacity 0.4s ease;
    z-index: 0;
  }

  .listing-card-wrapper:hover .ambient-glow {
    opacity: 1;
  }

  .dynamic-card {
    position: relative;
    z-index: 1;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 24px;
    padding: 0.75rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    transform-style: preserve-3d;
    transition: transform 0.15s ease-out, box-shadow 0.3s ease;
  }

  .listing-card-wrapper:hover .dynamic-card {
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }

  .card-img-wrapper {
    position: relative;
    height: 18rem;
    border-radius: 18px;
    overflow: hidden;
    transform: translateZ(20px);
  }

  .card-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .listing-card-wrapper:hover img {
    transform: scale(1.08);
  }

  .badge-overlay {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(8px);
    color: #fff;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transform: translateZ(30px);
  }

  .card-details {
    padding: 1rem 0.5rem 0.5rem;
    transform: translateZ(30px);
  }

  .card-title-text {
    font-size: 1.05rem;
    font-weight: 700;
    color: #1e293b;
    margin: 0 0 0.25rem 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .price-tag {
    font-weight: 600;
    color: #475569;
    font-size: 0.95rem;
  }
</style>

<body>
  <!-- Floating Glass Filter Bar -->
  <div class="filter-wrapper">
    <div id="filters">
      <% 
        const categories = [
          { name: "Trending", icon: "fa-fire" },
          { name: "Rooms", icon: "fa-bed" },
          { name: "Iconic cities", icon: "fa-mountain-city" },
          { name: "Mountains", icon: "fa-mountain" },
          { name: "Castles", icon: "fa-building-columns" },
          { name: "Amazing pools", icon: "fa-person-swimming" },
          { name: "Camping", icon: "fa-campground" },
          { name: "Farm", icon: "fa-cow" },
          { name: "Arctic", icon: "fa-igloo" },
          { name: "Beach", icon: "fa-umbrella-beach" },
          { name: "Monuments", icon: "fa-monument" }
        ];
      %>

      <% for (let cat of categories) { %>
        <a href="/listings?category=<%= encodeURIComponent(cat.name) %>" 
           class="filter-link <%= activeCategory === cat.name ? 'active-filter' : '' %>">
          <div class="filter">
            <div><i class="fa-solid <%= cat.icon %>"></i></div>
            <p><%= cat.name %></p>
          </div>
        </a>
      <% } %>

      <% if (activeCategory || searchQuery) { %>
        <a href="/listings" class="clear-btn">
          <p>Clear All</p>
        </a>
      <% } %>
    </div>
  </div>
   
  <div class="grid-container">
    <% for(let listing of allListings){ %>
      <a href="/listings/<%=listing._id%>" class="listing-card-wrapper">
        <div class="ambient-glow"></div>
        <div class="dynamic-card">
          <div class="card-img-wrapper">
            <img src="<%=listing.image.url%>" alt="listing_image" />
            <div class="badge-overlay">Explore</div>
          </div>
          <div class="card-details">
            <h3 class="card-title-text"><%=listing.title%></h3>
            <div class="price-tag">
              &#8377; <%= listing.price ? Number(listing.price).toLocaleString("en-IN") : "N/A" %> <span class="text-xs font-normal">/ night</span>
            </div>
          </div>
        </div>
      </a>
    <% } %>
  </div>

  <script>
    // Pure JS 3D Parallax & Mouse Tracking Effect
    const cards = document.querySelectorAll('.listing-card-wrapper');

    cards.forEach(card => {
      const innerCard = card.querySelector('.dynamic-card');

      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;

        const rotateX = ((y - centerY) / centerY) * -12; // Max tilt deg
        const rotateY = ((x - centerX) / centerX) * 12;

        innerCard.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
      });

      card.addEventListener('mouseleave', () => {
        innerCard.style.transform = `rotateX(0deg) rotateY(0deg)`;
      });
    });
  </script>
  <%- include("../partials/chatbot.ejs") %>
</body>