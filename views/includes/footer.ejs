<style>
  .custom-footer {
    background: #0f172a;
    color: #94a3b8;
    padding: 3rem 0 1.5rem 0;
    margin-top: 4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-family: inherit;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 2rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-brand h4 {
    color: #ffffff;
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-brand p {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #94a3b8;
  }

  .footer-column h5 {
    color: #f8fafc;
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 1rem;
    letter-spacing: 0.05em;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links li {
    margin-bottom: 0.6rem;
  }

  .footer-links a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .footer-links a:hover {
    color: #ff385c;
    transform: translateX(3px);
  }
.social-icons {
  display: flex;
  gap: 1rem;
  margin-top: 0.75rem;
}

.social-icon-btn {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #f8fafc;
  text-decoration: none;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border: 1px solid rgba(255, 255, 255, 0.1);
  padding: 0; /* Prevents default padding pushing background */
  box-sizing: border-box;
}

/* Fix Font Awesome icon offset */
.social-icon-btn i {
  margin: 0 !important;
  padding: 0 !important;
  line-height: 1 !important;
  font-size: 1rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

.social-icon-btn:hover {
  background: #ff385c;
  color: #ffffff;
  transform: translateY(-3px);
  box-shadow: 0 4px 12px rgba(255, 56, 92, 0.35);
  border-color: transparent;
}

  /* Bottom Bar / Attribution */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.5rem;
    font-size: 0.8rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .developer-badge {
    background: rgba(255, 255, 255, 0.05);
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .developer-badge a {
    color: #f8fafc;
    text-decoration: none;
    font-weight: 600;
  }

  .developer-badge a:hover {
    color: #ff385c;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }
  }
</style>

<footer class="custom-footer">
  <div class="footer-container">
    <div class="footer-grid">
      <!-- Brand & Mission -->
      <div class="footer-brand">
        <h4><i class="fa-regular fa-compass text-danger"></i> Traworld</h4>
        <p>Discover handpicked stays, unique experiences, and unforgettable destinations around the globe.</p>
        <div class="social-icons">
          <a href="#" class="social-icon-btn" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
          <a href="#" class="social-icon-btn" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
          <a href="#" class="social-icon-btn" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
          <a href="#" class="social-icon-btn" aria-label="Github"><i class="fa-brands fa-github"></i></a>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="footer-column">
        <h5>EXPLORE</h5>
        <ul class="footer-links">
          <li><a href="/listings">All Listings</a></li>
          <li><a href="/listings/new">Host Your Space</a></li>
          <li><a href="#">Trending Cities</a></li>
        </ul>
      </div>

      <!-- Legal Links -->
      <div class="footer-column">
        <h5>LEGAL</h5>
        <ul class="footer-links">
          <li><a href="/privacy">Privacy Policy</a></li>
          <li><a href="/terms">Terms of Service</a></li>
          <li><a href="#">Sitemap</a></li>
        </ul>
      </div>

      <!-- Contact / Support -->
      <div class="footer-column">
        <h5>SUPPORT</h5>
        <ul class="footer-links">
          <li><a href="#">Help Center</a></li>
          <li><a href="#">Cancellation Options</a></li>
          <li><a href="">support@traworld.com</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Developer Credit & Copyright -->
    <div class="footer-bottom">
      <div>&copy; <%= new Date().getFullYear() %> Traworld Private Limited. All rights reserved.</div>
      <div class="developer-badge">
        Crafted with <i class="fa-solid fa-heart text-danger"></i> by <a href="https://github.com/VishalChouhan17" target="_blank">Vishal chouhan</a>
      </div>
    </div>
  </div>
</footer>